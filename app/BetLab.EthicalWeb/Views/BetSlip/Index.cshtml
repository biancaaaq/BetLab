@model BetLab.EthicalWeb.Models.BetSlipViewModel

@{
    ViewData["Title"] = "Biletul meu";
    var roCulture = new System.Globalization.CultureInfo("ro-RO");

    string ImpliedProbability(decimal odds)
    {
        if (odds <= 1m) return "—";
        var prob = Math.Round(1m / odds * 100m, 1);
        return $"{prob.ToString("0.#", roCulture)}%";
    }

    var totalOdds = Model.TotalOdds;
    var combinedProb = Model.Items.Any() && totalOdds > 0 ? Math.Round(1m / totalOdds * 100m, 2) : 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Biletul meu</h1>
        <p class="ethical-muted mb-0">Verifică selecțiile, alege miza și confirmă cu calm.</p>
    </div>
    @if (Model.Items.Any())
    {
        <span class="rtp-badge">
            <i data-lucide="ticket"></i>
            <span>@Model.Items.Count @(Model.Items.Count == 1 ? "selecție" : "selecții")</span>
        </span>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">
        <i data-lucide="alert-circle"></i>
        <div>@TempData["Error"]</div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="eth-alert eth-alert-success mb-3">
        <i data-lucide="check-circle"></i>
        <div>
            <strong>@TempData["Success"]</strong>
            Îl găsești în <a asp-controller="MyBets" asp-action="Index">Biletele mele</a>.
        </div>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="ethical-panel text-center" style="padding: 3rem 1.5rem;">
        <i data-lucide="ticket" style="width: 48px; height: 48px; color: var(--muted); margin-bottom: 1rem;"></i>
        <h3>Biletul tău este gol</h3>
        <p class="ethical-muted mb-3">Mergi la pagina de meciuri și alege ce vrei să pariezi.</p>
        <a asp-controller="Events" asp-action="Index" class="btn btn-primary">
            <i data-lucide="trophy"></i>
            <span>Vezi meciurile</span>
        </a>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Selecții -->
        <div class="col-lg-8">
            <div class="ethical-panel-title mb-3">
                <i data-lucide="list-checks"></i>
                <span>Selecțiile tale</span>
            </div>

            @foreach (var item in Model.Items)
            {
                <div class="betslip-row">
                    <div class="betslip-row-header">
                        <div>
                            <div class="betslip-row-event">@item.EventName</div>
                            <div class="betslip-row-selection">@item.MarketName · @item.OutcomeName</div>
                        </div>
                        <span class="betslip-row-odds">@item.Odds.ToString("0.00", roCulture)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="ethical-muted" style="font-size: 0.85rem;">
                            <i data-lucide="percent" style="width: 13px; height: 13px;"></i>
                            Șansă estimată: <strong>@ImpliedProbability(item.Odds)</strong>
                        </span>
                        <form asp-controller="BetSlip" asp-action="Remove" method="post" class="d-inline">
                            <input type="hidden" name="outcomeId" value="@item.OutcomeId" />
                            <button type="submit" class="btn btn-ghost btn-sm" title="Elimină selecția">
                                <i data-lucide="x"></i>
                                <span>Elimină</span>
                            </button>
                        </form>
                    </div>
                </div>
            }

            <form asp-controller="BetSlip" asp-action="Clear" method="post" class="mt-3"
                  onsubmit="return confirm('Sigur vrei să golești biletul?');">
                <button type="submit" class="btn btn-ghost btn-sm">
                    <i data-lucide="trash-2"></i>
                    <span>Golește biletul</span>
                </button>
            </form>
        </div>

        <!-- Sumar / Plasare -->
        <div class="col-lg-4">
            <div class="betslip-summary">
                <div class="ethical-panel-title mb-3">
                    <i data-lucide="calculator"></i>
                    <span>Sumar bilet</span>
                </div>

                <div class="betslip-row-data">
                    <span>Selecții</span>
                    <strong class="text-strong">@Model.Items.Count</strong>
                </div>
                <div class="betslip-row-data">
                    <span>Cotă totală</span>
                    <strong class="text-strong">@totalOdds.ToString("0.00", roCulture)</strong>
                </div>
                <div class="betslip-row-data">
                    <span>Șansă combinată</span>
                    <strong class="text-strong">@combinedProb.ToString("0.##", roCulture)%</strong>
                </div>

                <form id="bet-form" asp-controller="BetSlip" asp-action="Place" method="post" class="mt-3">
                    <label for="stake" class="form-label">Miză</label>
                    <div class="input-group mb-2">
                        <input type="number"
                               id="stake"
                               name="stake"
                               class="form-control"
                               step="0.01"
                               min="1"
                               placeholder="0.00"
                               required
                               autocomplete="off"
                               data-total-odds="@totalOdds.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        <span class="input-group-text">RON</span>
                    </div>

                    <div class="betslip-row-data mb-1">
                        <span style="color:var(--danger,#DC2626);font-weight:600;">
                            <i data-lucide="alert-triangle" style="width:13px;height:13px;vertical-align:middle;"></i>
                            Risc (miză)
                        </span>
                        <strong id="potential-risk" style="color:var(--danger,#DC2626);">0.00 RON</strong>
                    </div>
                    <div class="betslip-row-data total mb-3">
                        <span>Câștig potențial</span>
                        <strong class="text-strong" id="potential-payout">0.00 RON</strong>
                    </div>

                    <button type="button" id="open-confirm" class="btn btn-primary w-100 justify-content-center btn-lg">
                        <i data-lucide="check"></i>
                        <span>Plasează pariul</span>
                    </button>
                </form>

                <p class="ethical-muted mt-3 mb-0" style="font-size: 0.82rem; line-height: 1.5;">
                    <i data-lucide="info" style="width: 13px; height: 13px;"></i>
                    Verifică sumarul înainte de a confirma. Pariurile pot fi anulate doar înainte de a fi plasate.
                </p>
            </div>
        </div>
    </div>

    <!-- Modal de confirmare -->
    <div id="confirm-modal" class="eth-modal-overlay" hidden>
        <div class="eth-modal" role="dialog" aria-labelledby="confirm-modal-title" aria-modal="true">
            <div class="eth-modal-header">
                <div class="eth-modal-title" id="confirm-modal-title">
                    <i data-lucide="shield-check"></i>
                    <span>Confirmă pariul</span>
                </div>
            </div>
            <div class="eth-modal-body">
                <p class="ethical-muted mb-3" style="font-size: 0.92rem;">
                    Verifică datele de mai jos. Odată confirmat, pariul nu mai poate fi anulat.
                </p>

                <div class="bet-summary-row">
                    <span>Selecții</span>
                    <strong class="text-strong">@Model.Items.Count</strong>
                </div>
                <div class="bet-summary-row">
                    <span>Cotă totală</span>
                    <strong class="text-strong">@totalOdds.ToString("0.00", roCulture)</strong>
                </div>
                <div class="bet-summary-row">
                    <span>Miză</span>
                    <strong class="text-strong"><span id="confirm-stake">0.00</span> RON</strong>
                </div>
                <div class="bet-summary-row" style="color:var(--danger,#DC2626);">
                    <span>
                        <i data-lucide="alert-triangle" style="width:13px;height:13px;vertical-align:middle;"></i>
                        Poți pierde
                    </span>
                    <strong style="color:var(--danger,#DC2626);"><span id="confirm-stake-risk">0.00</span> RON</strong>
                </div>
                <div class="bet-summary-row highlight">
                    <span>Câștig potențial</span>
                    <strong><span id="confirm-payout">0.00</span> RON</strong>
                </div>

                <div class="bet-summary-prob">
                    <i data-lucide="percent"></i>
                    <span>
                        Șansă estimată de câștig: <strong>@combinedProb.ToString("0.##", roCulture)%</strong>.
                        Cu cât pariezi pe mai multe selecții, cu atât scade probabilitatea de a le nimeri pe toate.
                    </span>
                </div>
            </div>
            <div class="eth-modal-footer">
                <button type="button" id="cancel-confirm" class="btn btn-outline-secondary">
                    <i data-lucide="arrow-left"></i>
                    <span>Înapoi</span>
                </button>
                <button type="button" id="do-confirm" class="btn btn-primary">
                    <i data-lucide="check"></i>
                    <span>Confirmă pariul</span>
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const stakeInput = document.getElementById('stake');
            const payoutEl = document.getElementById('potential-payout');
            const openBtn = document.getElementById('open-confirm');
            const modal = document.getElementById('confirm-modal');
            const cancelBtn = document.getElementById('cancel-confirm');
            const confirmBtn = document.getElementById('do-confirm');
            const form = document.getElementById('bet-form');
            const confirmStakeEl = document.getElementById('confirm-stake');
            const confirmPayoutEl = document.getElementById('confirm-payout');

            if (!stakeInput) return;

            const totalOdds = parseFloat(stakeInput.dataset.totalOdds || '0');

            function formatRon(n) {
                if (!isFinite(n) || n <= 0) return '0.00';
                return n.toFixed(2).replace('.', ',');
            }

            function updatePayout() {
                const stake = parseFloat(stakeInput.value || '0');
                const payout = stake > 0 && totalOdds > 0 ? stake * totalOdds : 0;
                if (payoutEl) payoutEl.textContent = formatRon(payout) + ' RON';
                const riskEl = document.getElementById('potential-risk');
                if (riskEl) riskEl.textContent = formatRon(stake) + ' RON';
            }

            stakeInput.addEventListener('input', updatePayout);
            updatePayout();

            function openModal() {
                const stake = parseFloat(stakeInput.value || '0');
                if (!stake || stake <= 0) {
                    stakeInput.focus();
                    stakeInput.reportValidity();
                    return;
                }
                const payout = stake * totalOdds;
                if (confirmStakeEl) confirmStakeEl.textContent = formatRon(stake);
                if (confirmPayoutEl) confirmPayoutEl.textContent = formatRon(payout);
                const confirmRiskEl = document.getElementById('confirm-stake-risk');
                if (confirmRiskEl) confirmRiskEl.textContent = formatRon(stake);
                modal.hidden = false;
                document.body.style.overflow = 'hidden';
                if (window.lucide) lucide.createIcons();

                ethLog('BetConfirmationViewed', 'BetSlip', {
                    targetType: 'Modal',
                    targetId: 'confirm-modal',
                    metadataJson: JSON.stringify({ stake: stake, totalOdds: totalOdds, payout: payout })
                });
            }

            function closeModal() {
                modal.hidden = true;
                document.body.style.overflow = '';

                ethLog('BetConfirmationCancelled', 'BetSlip', {
                    targetType: 'Button',
                    targetId: 'cancel-confirm'
                });
            }

            if (openBtn) openBtn.addEventListener('click', openModal);
            if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
            if (confirmBtn) confirmBtn.addEventListener('click', function () {
                confirmBtn.disabled = true;
                form.submit();
            });

            // Click pe overlay-ul din afara modalului = închidere
            modal && modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            // ESC = închidere
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
            });
        })();
    </script>
}
