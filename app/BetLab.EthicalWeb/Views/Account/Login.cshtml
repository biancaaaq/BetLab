@model BetLab.EthicalWeb.Models.LoginViewModel

@{
    ViewData["Title"] = "Autentificare";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <div class="eth-brand-mark mx-auto mb-3" style="width: 48px; height: 48px; border-radius: 14px;">
            <i data-lucide="shield-check" style="width: 26px; height: 26px;"></i>
        </div>
        <h1 class="auth-title">Bine ai revenit</h1>
        <p class="auth-subtitle">Autentifică-te ca să continui</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mb-3">
            <i data-lucide="alert-circle"></i>
            <div>@ViewBag.Error</div>
        </div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email"
                   class="form-control"
                   type="email"
                   autocomplete="email"
                   placeholder="adresa@exemplu.ro"
                   required />
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Parolă</label>
            <input asp-for="Password"
                   class="form-control"
                   type="password"
                   autocomplete="current-password"
                   placeholder="••••••••"
                   required />
        </div>

        <button type="submit" class="btn btn-primary w-100 justify-content-center btn-lg">
            <i data-lucide="log-in"></i>
            <span>Autentificare</span>
        </button>
    </form>

    <div class="auth-footer">
        Nu ai cont încă?
        <a asp-action="Register">Creează unul acum</a>
    </div>
</div>
