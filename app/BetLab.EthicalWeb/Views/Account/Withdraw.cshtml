@{
    ViewData["Title"] = "Retragere fonduri demo";
    var pendingAmount = TempData["WithdrawPending"] as string;
}

<h1 class="mb-1">Retragere fonduri demo</h1>
<p class="ethical-muted mb-4">
    Solicită retragerea fondurilor demonstrative din contul tău.
</p>

@if (pendingAmount != null)
{
    <div class="alert alert-success mb-4">
        <i data-lucide="check-circle"></i>
        <div>
            <strong>Cerere înregistrată.</strong>
            Retragerea de <strong>@pendingAmount RON</strong> a fost trimisă spre procesare.
            Timpul estimat de procesare este <strong>3–5 zile lucrătoare</strong>.
            Vei fi notificat prin email la finalizare.
        </div>
    </div>

    <div class="ethical-panel mb-4">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
            <i data-lucide="clock" style="color:var(--primary);"></i>
            <span style="font-weight:600;">Detalii cerere</span>
        </div>
        <div class="row g-3" style="font-size:0.9rem;">
            <div class="col-sm-4">
                <div class="ethical-muted mb-1" style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Sumă</div>
                <div style="font-weight:700;">@pendingAmount RON</div>
            </div>
            <div class="col-sm-4">
                <div class="ethical-muted mb-1" style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Status</div>
                <span class="rtp-badge" style="background:#FEF3C7;color:#92400E;border-color:#FDE68A;">
                    <i data-lucide="clock" style="width:12px;height:12px;"></i>
                    <span>În procesare</span>
                </span>
            </div>
            <div class="col-sm-4">
                <div class="ethical-muted mb-1" style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Timp estimat</div>
                <div style="font-weight:600;">3–5 zile lucrătoare</div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3">
        <a asp-controller="Account" asp-action="Withdraw" class="btn btn-outline-secondary">
            <i data-lucide="plus"></i>
            <span>Cerere nouă</span>
        </a>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">
            <i data-lucide="user"></i>
            <span>Înapoi la profil</span>
        </a>
    </div>
}
else
{
    @if (TempData["WithdrawError"] != null)
    {
        <div class="alert alert-danger mb-4">
            <i data-lucide="alert-circle"></i>
            <div>@TempData["WithdrawError"]</div>
        </div>
    }

    <div class="row g-4 justify-content-center">
        <div class="col-lg-6">

            <!-- Info demo -->
            <div class="alert" style="background:var(--info-soft,#EFF6FF);border:1px solid #BFDBFE;color:#1E40AF;border-radius:var(--radius,8px);display:flex;align-items:flex-start;gap:0.75rem;padding:1rem 1.25rem;margin-bottom:1.5rem;">
                <i data-lucide="info" style="flex-shrink:0;margin-top:0.1rem;width:18px;height:18px;"></i>
                <div style="font-size:0.88rem;line-height:1.6;">
                    Aceasta este o platformă de cercetare. Fondurile sunt <strong>demonstrative</strong> — retragerea simulează procesul fără tranzacții reale.
                </div>
            </div>

            <!-- Formular retragere -->
            <div class="ethical-panel mb-4">
                <div class="ethical-panel-header">
                    <div class="ethical-panel-title">
                        <i data-lucide="bank"></i>
                        <span>Detalii retragere</span>
                    </div>
                </div>

                <form asp-action="Withdraw" method="post">

                    <!-- Sumă -->
                    <div style="margin-bottom:1.1rem;">
                        <label class="form-label">Sumă de retras</label>
                        <div class="input-group">
                            <input type="number" name="amount" id="withdraw-amount"
                                   min="10" max="50000" step="10"
                                   class="form-control" value="100" required
                                   oninput="syncWithdrawPreview(this.value)" />
                            <span class="input-group-text">RON</span>
                        </div>
                        <div class="form-text">Suma minimă: 10 RON</div>
                    </div>

                    <!-- IBAN -->
                    <div style="margin-bottom:1.1rem;">
                        <label class="form-label">IBAN</label>
                        <input type="text" name="iban" class="form-control"
                               placeholder="RO49 AAAA 1B31 0075 9384 0000"
                               maxlength="29" required
                               oninput="formatIban(this)"
                               style="font-family:monospace;" />
                        <div class="form-text">Contul trebuie să fie pe numele tău.</div>
                    </div>

                    <!-- Preview -->
                    <div style="background:var(--bg-soft,#F9FAFB);border:1px solid var(--border,#E5E7EB);border-radius:var(--radius,8px);padding:0.85rem 1rem;margin-bottom:1.25rem;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span class="ethical-muted" style="font-size:0.85rem;">Vei retrage</span>
                            <span id="withdraw-preview" style="font-size:1.2rem;font-weight:700;color:var(--primary);">100,00 RON</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" style="padding:0.75rem;font-size:1rem;">
                        <i data-lucide="send"></i>
                        <span>Trimite cererea</span>
                    </button>

                </form>
            </div>

            <!-- Info procesare -->
            <div class="ethical-panel">
                <div class="ethical-panel-title mb-3">
                    <i data-lucide="info"></i>
                    <span>Informații procesare</span>
                </div>
                <ul style="font-size:0.85rem;color:var(--text-muted);line-height:2;margin:0;padding-left:1.2rem;">
                    <li>Retragerile sunt procesate în <strong>3–5 zile lucrătoare</strong></li>
                    <li>Suma minimă per retragere: <strong>10 RON</strong></li>
                    <li>Nicio taxă de procesare</li>
                    <li>Vei primi confirmare prin email</li>
                </ul>
            </div>

        </div>
    </div>
}

@section Scripts {
<script>
function syncWithdrawPreview(val) {
    var amt = parseFloat(val) || 0;
    document.getElementById('withdraw-preview').textContent =
        amt.toLocaleString('ro-RO', {minimumFractionDigits:2}) + ' RON';
}

function formatIban(el) {
    var val = el.value.replace(/\s/g, '').toUpperCase();
    el.value = (val.match(/.{1,4}/g) || []).join(' ');
}
</script>
}
