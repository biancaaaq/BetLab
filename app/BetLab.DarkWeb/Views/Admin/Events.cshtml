@model List<BetLab.DarkWeb.Models.AdminEventViewModel>
@{
    ViewData["Title"] = "Admin — Evenimente";
    string StatusBadge(string s) => s switch {
        "Open"     => "badge bg-primary",
        "Live"     => "badge bg-success",
        "Finished" => "badge bg-secondary",
        _          => "badge bg-dark"
    };
    var liveCount     = Model.Count(e => e.Status == "Live");
    var openCount     = Model.Count(e => e.Status == "Open");
    var finishedCount = Model.Count(e => e.Status == "Finished");

    var competitions = new[] {
        new { LeagueId =   1, Season = 2026, Name = "FIFA World Cup 2026",   Country = "International" },
        new { LeagueId =   2, Season = 2025, Name = "UEFA Champions League", Country = "Europe" },
        new { LeagueId =  39, Season = 2025, Name = "Premier League",        Country = "England" },
        new { LeagueId = 140, Season = 2025, Name = "La Liga",               Country = "Spain" },
        new { LeagueId =  78, Season = 2025, Name = "Bundesliga",            Country = "Germany" },
        new { LeagueId = 135, Season = 2025, Name = "Serie A",               Country = "Italy" },
        new { LeagueId =  61, Season = 2025, Name = "Ligue 1",               Country = "France" },
        new { LeagueId = 283, Season = 2025, Name = "Superliga României",    Country = "Romania" },
    };
}

<!-- Header simplu (neutru, nu Dark pattern) -->
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#f1f5f9;">📅 Gestionare evenimente</h1>
        <div class="small">
            <span class="badge bg-primary-subtle text-primary">@openCount Open</span>
            <span class="badge bg-success-subtle text-success">@liveCount Live</span>
            <span class="badge bg-secondary-subtle text-secondary">@finishedCount Finalizate</span>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

<!-- Notice neutru -->
<div class="alert py-2 mb-3" style="background:#0f172a;border:1px solid #334155;color:#cbd5e1;font-size:0.8rem;">
    <strong style="color:#60a5fa;">ℹ️ Modificările aici se aplică pe AMBELE platforme</strong> (Ethical + Dark) — backend unic.
    Câștigătorul se determină automat din API-FOOTBALL. Admin nu poate selecta manual cine câștigă.
</div>

@if (TempData["AdminSuccess"] != null)
{ <div class="alert alert-success py-2 mb-3">✅ @TempData["AdminSuccess"]</div> }
@if (TempData["AdminError"] != null)
{ <div class="alert alert-danger py-2 mb-3">⚠️ @TempData["AdminError"]</div> }

<!-- 3 panouri de acțiuni -->
<div class="row g-3 mb-3">

    <!-- LIVE -->
    <div class="col-lg-4">
        <div class="card h-100" style="background:#0f172a;border:1px solid #b91c1c;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span style="font-size:1.4rem;">🔴</span>
                    <h6 class="fw-bold mb-0" style="color:#f1f5f9;">Live & Sync</h6>
                </div>
                <p class="small mb-3" style="color:#94a3b8;">Pentru meciurile în desfășurare</p>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="autoSyncToggle"
                            class="btn btn-outline-success btn-sm flex-grow-1"
                            onclick="toggleAutoSync()">
                        ⏸ Auto-sync OFF
                    </button>
                    <form asp-action="SyncLiveApiFootball" method="post" class="d-inline">
                        <button class="btn btn-outline-danger btn-sm">🔄 Sync acum</button>
                    </form>
                </div>

                <div class="mt-3 small" style="color:#94a3b8;">
                    <div>📊 <strong style="color:#f1f5f9;">@liveCount</strong> @(liveCount == 1 ? "meci" : "meciuri") live</div>
                    <div>⏱️ Ultimul sync: <strong id="lastSyncDisplay" style="color:#94a3b8;">niciodată</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- PRE-MECI -->
    <div class="col-lg-4">
        <div class="card h-100" style="background:#0f172a;border:1px solid #1e40af;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span style="font-size:1.4rem;">📥</span>
                    <h6 class="fw-bold mb-0" style="color:#f1f5f9;">Pre-meci</h6>
                </div>
                <p class="small mb-3" style="color:#94a3b8;">Import meciuri viitoare + adăugare manuală</p>

                <div class="d-flex flex-column gap-2">
                    <div class="dropdown">
                        <button class="btn btn-outline-info btn-sm dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">
                            ⬇️ Import competiție
                        </button>
                        <ul class="dropdown-menu w-100" style="background:#0f172a;border:1px solid #334155;">
                            @foreach (var comp in competitions)
                            {
                                <li>
                                    <form asp-action="ImportApiFootball" method="post" class="d-inline w-100">
                                        <input type="hidden" name="leagueId" value="@comp.LeagueId" />
                                        <input type="hidden" name="season"   value="@comp.Season" />
                                        <input type="hidden" name="name"     value="@comp.Name" />
                                        <input type="hidden" name="country"  value="@comp.Country" />
                                        <input type="hidden" name="onlyUpcoming" value="true" />
                                        <button class="dropdown-item" style="color:#e2e8f0;">
                                            @comp.Name <small style="color:#64748b;">(@comp.Country)</small>
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>

                    <form asp-action="ImportApiFootballFixture" method="post" class="input-group input-group-sm">
                        <input type="number" name="fixtureId" placeholder="Fixture ID API-FOOTBALL"
                               class="form-control" style="background:#0f172a;border-color:#334155;color:#f1f5f9;" required />
                        <button class="btn btn-outline-success">📥 Import</button>
                    </form>

                    <a asp-action="AddEvent" class="btn btn-primary btn-sm">➕ Adaugă manual</a>
                </div>
            </div>
        </div>
    </div>

    <!-- DECONTARE -->
    <div class="col-lg-4">
        <div class="card h-100" style="background:#0f172a;border:1px solid #b45309;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span style="font-size:1.4rem;">💰</span>
                    <h6 class="fw-bold mb-0" style="color:#f1f5f9;">Decontare</h6>
                </div>
                <p class="small mb-3" style="color:#94a3b8;">Procesare plăți pentru meciurile finalizate</p>

                <form asp-action="SyncEvents" method="post"
                      onsubmit="return confirm('Sincronizezi și decontezi automat toate meciurile finalizate?')">
                    <input type="hidden" name="autoSettle" value="true" />
                    <button class="btn btn-warning btn-sm w-100">⚡ Sync + Decontare auto</button>
                </form>

                <div class="mt-3 small" style="color:#94a3b8;">
                    Decontează automat toate meciurile cu status <strong style="color:#f1f5f9;">Finished</strong> și plătește câștigătorii.
                </div>
            </div>
        </div>
    </div>

</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">Nu există evenimente.</div>
}
else
{
    @foreach (var ev in Model)
    {
        var isOpen     = ev.Status == "Open";
        var isLive     = ev.Status == "Live";
        var isFinished = ev.Status == "Finished";
        var mainMarket = ev.Markets.FirstOrDefault();

        <div class="card mb-3" style="background:#1e293b;border:1px solid @(isLive ? "#22c55e" : "#334155");">
            <div class="card-body">
                <!-- Header -->
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <div class="fw-bold" style="color:#f1f5f9;font-size:1rem;">
                            @ev.HomeTeam <span class="text-muted">vs</span> @ev.AwayTeam
                        </div>
                        <div style="font-size:0.78rem;color:#94a3b8;">
                            @ev.Competition · @ev.StartTimeUtc.ToRomanianTime().ToString("dd MMM yyyy HH:mm")
                            · <strong style="color:#fbbf24;">@ev.BetCount pariuri</strong>
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <span class="@StatusBadge(ev.Status)">@ev.Status</span>
                        @if (isLive)
                        { <span class="badge bg-danger blink-live">● LIVE</span> }
                        <span class="badge" style="background:#1e293b;color:#fbbf24;border:1px solid #fbbf24;">
                            📊 @ev.Markets.Count piețe
                        </span>
                        @if (ev.Markets.Count <= 1 && !isFinished)
                        {
                            <form asp-action="GenerateMarkets" method="post" class="d-inline">
                                <input type="hidden" name="eventId" value="@ev.Id" />
                                <button class="btn btn-sm btn-outline-primary" title="Generează Dublă șansă, BTTS, Over/Under, Scor exact, HT/FT">
                                    + Generează cote
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Cote principale -->
                @if (mainMarket != null)
                {
                    <div class="mb-3">
                        <div class="text-muted mb-1" style="font-size:0.72rem;text-transform:uppercase;letter-spacing:.05em;">@mainMarket.Name</div>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var o in mainMarket.Outcomes)
                            {
                                <div class="d-flex align-items-center gap-1 p-2 rounded"
                                     style="background:@(o.IsWinning ? "#15803d" : "#0f172a");border:1px solid @(o.IsWinning ? "#22c55e" : "#1e293b");min-width:80px;">
                                    <div>
                                        <div style="font-size:0.7rem;color:#94a3b8;">@o.Code · @o.Name</div>
                                        <div style="font-size:1rem;font-weight:800;color:#f1f5f9;">@o.Odds.ToString("F2")</div>
                                    </div>
                                    @if (o.IsWinning)
                                    { <span class="ms-auto" title="Câștigător">✅</span> }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Acțiuni -->
                <div class="d-flex gap-2 flex-wrap">
                    @if (isOpen)
                    {
                        <form asp-action="MarkLive" method="post" class="d-inline">
                            <input type="hidden" name="eventId" value="@ev.Id" />
                            <button class="btn btn-sm btn-success">🔴 Marchează LIVE</button>
                        </form>
                    }
                    @if (isLive)
                    {
                        <form asp-action="MarkOpen" method="post" class="d-inline">
                            <input type="hidden" name="eventId" value="@ev.Id" />
                            <button class="btn btn-sm btn-outline-secondary">Scoate din LIVE</button>
                        </form>
                    }
                    @if (!isFinished && mainMarket != null)
                    {
                        var winningOutcome = mainMarket.Outcomes.FirstOrDefault(o => o.IsWinning);
                        @if (winningOutcome != null)
                        {
                            <!-- Câștigător determinat automat de API — admin NU poate modifica -->
                            <span class="badge"
                                  style="background:#15803d;color:white;border:1px solid #22c55e;font-size:0.78rem;padding:0.4rem 0.6rem;">
                                ✓ Câștigător: <strong>@winningOutcome.Code · @winningOutcome.Name</strong>
                                <span style="opacity:0.8;font-size:0.7rem;margin-left:0.25rem;">(verificat oficial)</span>
                            </span>
                            <form asp-action="SettleEvent" method="post" class="d-inline"
                                  onsubmit="return confirm('Decontezi evenimentul și procesezi toate pariurile. Continui?')">
                                <input type="hidden" name="eventId" value="@ev.Id" />
                                <button class="btn btn-sm btn-danger">💰 Decontează</button>
                            </form>
                        }
                        else
                        {
                            <span style="color:#94a3b8;font-size:0.78rem;font-style:italic;">
                                ⏳ Așteptăm rezultat oficial — folosește <strong>Sync statusuri</strong> după ce meciul s-a încheiat.
                            </span>
                        }
                    }
                    @if (isFinished)
                    {
                        <span class="text-muted" style="font-size:0.8rem;">Eveniment finalizat</span>
                    }
                </div>
            </div>
        </div>
    }
}

@section Scripts {
<script>
    // Auto-sync + display "ultimul sync"
    (function () {
        var KEY_ON   = 'dark_admin_autosync';
        var KEY_LAST = 'dark_admin_lastsync';
        var INTERVAL_MS = 20 * 1000;  // 20 secunde — plan Plus = 7500 cereri/zi
        var timerId = null;

        function setLabel(on) {
            var btn = document.getElementById('autoSyncToggle');
            if (!btn) return;
            if (on) {
                btn.textContent = '⏵ Auto-sync ON (20s)';
                btn.classList.remove('btn-outline-success');
                btn.classList.add('btn-success');
            } else {
                btn.textContent = '⏸ Auto-sync OFF';
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            }
        }

        function updateLastSyncDisplay() {
            var el = document.getElementById('lastSyncDisplay');
            if (!el) return;
            var ts = parseInt(sessionStorage.getItem(KEY_LAST) || '0', 10);
            if (!ts) { el.textContent = 'niciodată'; el.style.color = '#64748b'; return; }
            var diff = Math.floor((Date.now() - ts) / 1000);
            var txt;
            if (diff < 5) txt = 'chiar acum';
            else if (diff < 60) txt = 'acum ' + diff + ' sec';
            else if (diff < 3600) txt = 'acum ' + Math.floor(diff / 60) + ' min';
            else txt = 'acum ' + Math.floor(diff / 3600) + ' h';
            el.textContent = txt;
            el.style.color = diff < 30 ? '#34d399' : (diff < 120 ? '#fbbf24' : '#94a3b8');
        }

        function doSync() {
            console.log('[auto-sync] Sync...');
            fetch('@Url.Action("SyncLiveApiFootball", "Admin")', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            }).then(function (r) {
                if (r.ok) {
                    sessionStorage.setItem(KEY_LAST, Date.now().toString());
                    updateLastSyncDisplay();
                    console.log('[auto-sync] OK');
                } else {
                    console.warn('[auto-sync] HTTP', r.status);
                }
            }).catch(function (e) {
                console.error('[auto-sync] Eroare:', e);
            });
        }

        function start() {
            stop();
            sessionStorage.setItem(KEY_ON, '1');
            setLabel(true);
            doSync();
            timerId = setInterval(doSync, INTERVAL_MS);
            console.log('[auto-sync] PORNIT la 20s.');
        }

        function stop() {
            if (timerId) { clearInterval(timerId); timerId = null; }
            sessionStorage.removeItem(KEY_ON);
            setLabel(false);
            console.log('[auto-sync] OPRIT.');
        }

        window.toggleAutoSync = function () {
            if (timerId) stop(); else start();
        };

        setInterval(updateLastSyncDisplay, 5000);
        updateLastSyncDisplay();

        if (sessionStorage.getItem(KEY_ON) === '1') {
            start();
        }
    })();
</script>
}

<style>
@@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }
.blink-live { animation: blink 1.2s ease-in-out infinite; }
</style>
