@model BetLab.DarkWeb.Models.AdminTransactionsPageViewModel
@{
    ViewData["Title"] = "Admin — Tranzacții";

    string TypeLabel(string t) => t switch {
        "InitialCredit"  => "Credit inițial",
        "Deposit"        => "Depunere",
        "Withdrawal"     => "Retragere",
        "BetPlaced"      => "Pariu plasat",
        "BetWon"         => "Câștig pariu",
        "AdminReset"     => "Reset admin",
        "CasinoSpin"     => "Spin casino",
        "RouletteSpinDebit" => "Ruleta debit",
        "RouletteSpinCredit" => "Ruleta câștig",
        "BlackjackStake" => "Blackjack miză",
        "BlackjackPayout" => "Blackjack câștig",
        _                => t
    };

    string TypeColor(string t) => t switch {
        "Deposit" or "InitialCredit" or "BetWon" or "RouletteSpinCredit" or "BlackjackPayout" => "text-success",
        "Withdrawal" or "BetPlaced" or "RouletteSpinDebit" or "BlackjackStake" or "CasinoSpin" => "text-danger",
        "AdminReset" => "text-warning",
        _ => "text-muted"
    };

    bool isCredit(string t) => t is "Deposit" or "InitialCredit" or "BetWon"
        or "RouletteSpinCredit" or "BlackjackPayout";

    var filters = new[] {
        ("", "Toate"),
        ("Deposit", "Depuneri"),
        ("Withdrawal", "Retrageri"),
        ("BetPlaced", "Pariuri plasate"),
        ("BetWon", "Câștiguri pariuri"),
        ("InitialCredit", "Credit inițial"),
        ("AdminReset", "Reset admin")
    };
    int totalPages = (int)Math.Ceiling((double)Model.Total / Model.PageSize);
}

<div class="mb-4 d-flex align-items-center gap-2 flex-wrap">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Dashboard</a>
    <h1 class="h4 fw-bold mb-0 ms-2" style="color:#fff;">💳 Tranzacții</h1>
    <span class="ms-auto text-muted" style="font-size:0.82rem;">@Model.Total total</span>
</div>

<!-- Filtre -->
<div class="d-flex gap-2 flex-wrap mb-3">
    @foreach (var (val, label) in filters)
    {
        <a asp-action="Transactions" asp-route-type="@val" asp-route-page="1"
           class="btn btn-sm @(Model.Filter == val || (val == "" && string.IsNullOrEmpty(Model.Filter)) ? "btn-primary" : "btn-outline-secondary")">
            @label
        </a>
    }
</div>

<div class="card" style="background:#1e293b;border:1px solid #334155;">
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-5">Nu există tranzacții.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" style="--bs-table-bg:#1e293b;--bs-table-hover-bg:#0f172a;">
                    <thead>
                        <tr style="border-bottom:1px solid #334155;font-size:0.72rem;text-transform:uppercase;color:#64748b;">
                            <th class="px-4 py-3">Data</th>
                            <th class="px-3 py-3">Utilizator</th>
                            <th class="px-3 py-3">Tip</th>
                            <th class="px-3 py-3 text-end">Sumă</th>
                            <th class="px-3 py-3 text-end">Sold înainte</th>
                            <th class="px-3 py-3 text-end">Sold după</th>
                            <th class="px-3 py-3">Descriere</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Items)
                        {
                            <tr style="border-bottom:1px solid #0f172a;">
                                <td class="px-4 py-3" style="color:#94a3b8;font-size:0.78rem;white-space:nowrap;">
                                    @t.CreatedAt.ToRomanianTime().ToString("dd MMM yyyy HH:mm")
                                </td>
                                <td class="px-3 py-3">
                                    <div style="color:#f1f5f9;font-size:0.82rem;">@(t.UserName ?? "—")</div>
                                    <div style="color:#94a3b8;font-size:0.72rem;">@t.UserEmail</div>
                                </td>
                                <td class="px-3 py-3">
                                    <span class="badge @TypeColor(t.Type)" style="background:transparent;padding:0;font-size:0.78rem;font-weight:600;">
                                        @TypeLabel(t.Type)
                                    </span>
                                </td>
                                <td class="px-3 py-3 text-end">
                                    <span class="fw-bold @TypeColor(t.Type)">
                                        @(isCredit(t.Type) ? "+" : "−")@t.Amount.ToString("F2")
                                    </span>
                                </td>
                                <td class="px-3 py-3 text-end" style="color:#94a3b8;font-size:0.82rem;">
                                    @t.BalanceBefore.ToString("F2")
                                </td>
                                <td class="px-3 py-3 text-end" style="color:#f1f5f9;font-size:0.82rem;">
                                    @t.BalanceAfter.ToString("F2")
                                </td>
                                <td class="px-3 py-3" style="color:#94a3b8;font-size:0.78rem;max-width:200px;">
                                    @(t.Description ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginare -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center gap-2 p-3">
                    @for (int i = 1; i <= Math.Min(totalPages, 10); i++)
                    {
                        <a asp-action="Transactions" asp-route-type="@Model.Filter" asp-route-page="@i"
                           class="btn btn-sm @(i == Model.Page ? "btn-primary" : "btn-outline-secondary")">@i</a>
                    }
                    @if (totalPages > 10)
                    { <span class="text-muted align-self-center">... @totalPages</span> }
                </div>
            }
        }
    </div>
</div>
